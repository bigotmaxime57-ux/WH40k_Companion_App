  "attacker": {
    "name": "Escouade de tir",
    "weapons": [
      {
        "modelCount": 9,
        "weapon": {
          "name": "Fusil",
          "type": "Ranged",
          "attacks": 2,
          "skill": 3,
          "strength": 4,
          "ap": -1,
          "damage": 1,
          "abilities": { "rapidFire": 1 }
        }
      },
      {
        "modelCount": 1,
        "weapon": {
          "name": "Canon lourd",
          "type": "Ranged",
          "attacks": "D6",
          "skill": 4,
          "strength": 9,
          "ap": -2,
          "damage": "D3",
          "abilities": { "blast": true, "heavy": true }
        }
      }
    ]
  },
  "defender": {
    "name": "Escouade + Leader",
    "boosts": { "inCover": false },
