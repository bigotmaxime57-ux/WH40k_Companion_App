<?xml version="1.0" encoding="utf-8" ?>
<!-- La fenêtre ne contient que le BlazorWebView : toute l'interface est le composant AppShell de Wh40kSim.UI. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:Wh40kSim.UI.Components;assembly=Wh40kSim.UI"
             x:Class="Wh40kSim.Desktop.MainPage">

    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:AppShell}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
