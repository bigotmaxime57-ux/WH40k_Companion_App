<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication à distribuer (tests) : application autonome, rien à installer chez l'utilisateur hormis WebView2 (déjà
  présent sous Windows 11 et Windows 10 à jour). .NET et Windows App SDK inclus. Utilisé par tools/publier.ps1 :
    dotnet publish src/Wh40kSim.Desktop -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishDir>bin\Publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
