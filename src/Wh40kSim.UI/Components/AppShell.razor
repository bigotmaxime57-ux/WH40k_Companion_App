@*
    Coquille de l'application, commune aux hôtes : fournisseurs MudBlazor, barre de titre (retour à l'accueil, nom de
    l'écran, menu des thèmes) et routeur vers les écrans (accueil, Quick sim). Thème au démarrage : celui fourni par
    l'hôte (InitialTheme), sinon le choix mémorisé (IPreferenceService), sinon celui qui correspond au mode clair / sombre
    du navigateur. Un thème choisi dans le menu est mémorisé. Pendant une simulation, le retour à l'accueil est bloqué.
    Barre de chargement quand un écran est ouvert par ScreenNavigator (tuiles de l'accueil) : la première construction
    d'un écran peut prendre un moment. Styles complémentaires : wwwroot/wh40ksim.css, chargé par l'hôte.
*@
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IPreferenceService Preferences
@inject NavigationManager Navigation
@inject ScenarioSession Session
@inject ScreenNavigator Screens

<MudThemeProvider @ref="_themeProvider" Theme="Wh40kTheme.For(_theme)" IsDarkMode="Wh40kTheme.IsDark(_theme)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@ShellClass">
    <MudAppBar Elevation="2" Dense="true">
        @if (ScreenName is not null)
        {
            <MudTooltip Text="@L["Nav_Home"]">
                <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Inherit" Disabled="Session.IsRunning" OnClick="GoHome"
                               aria-label="@L["Nav_Home"]" data-test="home" />
            </MudTooltip>
        }
        <MudIcon Icon="@Icons.Material.Filled.MilitaryTech" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="wh-brand">@L["App_Title"]</MudText>
        @if (ScreenName is not null)
        {
            <MudText Typo="Typo.h6" Class="wh-brand wh-screen-name" data-test="screen-name">@ScreenName</MudText>
        }
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AriaLabel="@L["App_Theme"]"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-test="theme-menu">
            @foreach (var choice in Enum.GetValues<ThemeChoice>())
            {
                <MudMenuItem Icon="@(choice == _theme ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                             OnClick="@(() => ChooseAsync(choice))" data-test="@($"theme-{choice}")">
                    @L[Wh40kTheme.NameKey(choice)]
                </MudMenuItem>
            }
        </MudMenu>
    </MudAppBar>
    @if (Screens.IsLoading)
    {
        <div class="wh-screen-loading-overlay" data-test="screen-loading">
            <div class="wh-screen-loading"><div class="wh-screen-loading-bar"></div></div>
        </div>
    }
    <MudMainContent>
        @* Version fournie par l'hôte, affichée par l'accueil *@
        <CascadingValue Name="AppVersion" Value="Version">
            <Router AppAssembly="typeof(AppShell).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="routeData" />
                </Found>
                <NotFound>
                    <HomePage />
                </NotFound>
            </Router>
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private ThemeChoice _theme;

    /// <summary>Nom de l'écran affiché après le titre, null sur l'accueil (pas de bouton de retour non plus).</summary>
    private string? ScreenName => CurrentRoute switch
    {
        AppRoutes.QuickSim => L["Mode_QuickSim"].Value,
        AppRoutes.FullSim or AppRoutes.FullSimResults => L["Mode_FullSim"].Value,
        _ => null,
    };

    /// <summary>Adresse de l'écran affiché, sans la base de l'application, la requête ni l'ancre.</summary>
    private string CurrentRoute => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    /// <summary>
    /// Thème au démarrage, fourni par l'hôte s'il le connaît (choix mémorisé, à défaut mode du système) : le premier
    /// rendu a alors déjà le bon thème. Sinon, il est cherché après le premier rendu (le thème clair s'affiche un instant).
    /// </summary>
    [Parameter]
    public ThemeChoice? InitialTheme { get; set; }

    /// <summary>Version de l'application, fournie par l'hôte (affichée sur l'accueil) ; null = non affichée.</summary>
    [Parameter]
    public string? Version { get; set; }

    /// <summary>Thème affiché.</summary>
    public ThemeChoice Theme => _theme;

    private string ShellClass => _theme switch
    {
        ThemeChoice.Grimdark => "wh-shell wh-dark wh-grimdark",
        ThemeChoice.Steel => "wh-shell wh-dark",
        ThemeChoice.Neon => "wh-shell wh-dark wh-neon",
        _ => "wh-shell",
    };

    protected override void OnInitialized()
    {
        _theme = InitialTheme ?? ThemeChoice.Parchment;
        Navigation.LocationChanged += OnLocationChanged;
        Screens.LoadingChanged += OnStateChanged;
        Session.RunningChanged += OnStateChanged;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Screens.LoadingChanged -= OnStateChanged;
        Session.RunningChanged -= OnStateChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        StateHasChanged();
        if (Screens.IsLoading)
        {
            // Le routeur construit le nouvel écran pendant ce même événement : la barre est retirée juste après
            await Task.Yield();
            Screens.Loaded();
        }
    });

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void GoHome()
    {
        if (!Session.IsRunning)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialTheme is null)
        {
            _theme = await Preferences.GetThemeAsync() ?? Wh40kTheme.Default(await _themeProvider.GetSystemDarkModeAsync());
            StateHasChanged();
        }
    }

    private async Task ChooseAsync(ThemeChoice choice)
    {
        _theme = choice;
        await Preferences.SetThemeAsync(choice);
    }
}
