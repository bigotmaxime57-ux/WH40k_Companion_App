@*
    Coquille de l'application, commune aux hôtes : fournisseurs MudBlazor, barre de titre avec le menu des thèmes, et la
    page « Simulateur ». Thème au démarrage : celui fourni par l'hôte (InitialTheme), sinon le choix mémorisé
    (IPreferenceService), sinon celui qui correspond au mode clair / sombre du navigateur. Un thème choisi dans le menu
    est mémorisé. Styles complémentaires : wwwroot/wh40ksim.css, chargé par l'hôte.
*@
@inject IPreferenceService Preferences

<MudThemeProvider @ref="_themeProvider" Theme="Wh40kTheme.For(_theme)" IsDarkMode="Wh40kTheme.IsDark(_theme)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@ShellClass">
    <MudAppBar Elevation="2" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.MilitaryTech" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="wh-brand">@L["App_Title"]</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AriaLabel="@L["App_Theme"]"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-test="theme-menu">
            @foreach (var choice in Enum.GetValues<ThemeChoice>())
            {
                <MudMenuItem Icon="@(choice == _theme ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                             OnClick="@(() => ChooseAsync(choice))" data-test="@($"theme-{choice}")">
                    @L[Wh40kTheme.NameKey(choice)]
                </MudMenuItem>
            }
        </MudMenu>
    </MudAppBar>
    <MudMainContent>
        <SimulatorPage />
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private ThemeChoice _theme;

    /// <summary>
    /// Thème au démarrage, fourni par l'hôte s'il le connaît (choix mémorisé, à défaut mode du système) : le premier
    /// rendu a alors déjà le bon thème. Sinon, il est cherché après le premier rendu (le thème clair s'affiche un instant).
    /// </summary>
    [Parameter]
    public ThemeChoice? InitialTheme { get; set; }

    /// <summary>Thème affiché.</summary>
    public ThemeChoice Theme => _theme;

    private string ShellClass => _theme switch
    {
        ThemeChoice.Grimdark => "wh-shell wh-dark wh-grimdark",
        ThemeChoice.Steel => "wh-shell wh-dark",
        ThemeChoice.Neon => "wh-shell wh-dark wh-neon",
        _ => "wh-shell",
    };

    protected override void OnInitialized() => _theme = InitialTheme ?? ThemeChoice.Parchment;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialTheme is null)
        {
            _theme = await Preferences.GetThemeAsync() ?? Wh40kTheme.Default(await _themeProvider.GetSystemDarkModeAsync());
            StateHasChanged();
        }
    }

    private async Task ChooseAsync(ThemeChoice choice)
    {
        _theme = choice;
        await Preferences.SetThemeAsync(choice);
    }
}
