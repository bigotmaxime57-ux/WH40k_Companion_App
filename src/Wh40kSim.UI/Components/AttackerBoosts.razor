@*
    Boosts de l'attaquant (auras, stratagèmes…), pour toutes ses armes : caractéristiques (sans plafond) et modificateurs
    aux jets (±1 au total), rangés par étape de la séquence d'attaque. Stockés dans AttackContext (JSON : « context »).
*@

<BoostSection ActiveCount="ActiveCount" Help="@([L["Help_AttackerBoosts"], L["Help_Skill"], L["Help_Strength"], L["Help_Roll"], L["Help_Profile"]])"
              data-test="attacker-boosts">
    <MudText Typo="Typo.caption" Class="wh-boost-row-title">@L["Boosts_Hit"]</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_Skill"]" Min="-6" Max="6" @bind-Value="Context.SkillModifier" @bind-Value:after="NotifyChanged"
                             data-test="skill-modifier" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Context_HitModifier"]" Min="-3" Max="3" @bind-Value="Context.HitModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="RerollPolicy" Label="@L["Context_HitReroll"]" @bind-Value="Context.HitReroll" @bind-Value:after="NotifyChanged">
                <RerollItems />
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="wh-boost-row-title">@L["Boosts_Wound"]</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_Strength"]" Min="-10" Max="10" @bind-Value="Context.StrengthModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Context_WoundModifier"]" Min="-3" Max="3" @bind-Value="Context.WoundModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="RerollPolicy" Label="@L["Context_WoundReroll"]" @bind-Value="Context.WoundReroll" @bind-Value:after="NotifyChanged">
                <RerollItems />
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="wh-boost-row-title">@L["Boosts_Profile"]</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_Attacks"]" Min="-6" Max="6" @bind-Value="Context.AttacksModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_Ap"]" Min="-6" Max="6" @bind-Value="Context.ApModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_Damage"]" Min="-6" Max="6" @bind-Value="Context.DamageModifier" @bind-Value:after="NotifyChanged" />
        </MudItem>
    </MudGrid>
</BoostSection>

@code {
    [Parameter, EditorRequired]
    public ContextForm Context { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    private int ActiveCount =>
        new[] { Context.SkillModifier, Context.HitModifier, Context.StrengthModifier, Context.WoundModifier,
                Context.AttacksModifier, Context.ApModifier, Context.DamageModifier }.Count(v => v != 0)
        + (Context.HitReroll != RerollPolicy.None ? 1 : 0)
        + (Context.WoundReroll != RerollPolicy.None ? 1 : 0);

    private Task NotifyChanged() => Changed.InvokeAsync();
}
