@*
    Attaquant : nom, boosts (pour toutes ses armes) et profils d'armes, résolus dans l'ordre de la liste. Boutons
    Ouvrir / Enregistrer de l'attaquant seul dans l'en-tête, si la page les fournit. Repliable (déplié à l'ouverture) sans perdre l'état des cartes qu'il contient.
*@

<MudPaper Elevation="3" Class="pa-4 wh-section wh-attacker" data-test="attacker-panel">
    <SectionHeader Icon="@Icons.Material.Filled.GpsFixed" Title="@L["Attacker_Title"]">
        <Leading>
            <CollapseToggle @bind-Expanded="_expanded" data-test="toggle-attacker" />
        </Leading>
        <ChildContent>
            @if (OnOpen.HasDelegate)
            {
                <PartFileActions OpenHelp="@L["Attacker_OpenHelp"]" SaveHelp="@L["Attacker_SaveHelp"]" Disabled="FileActionsDisabled"
                                 SaveDisabled="SaveDisabled" OnOpen="OnOpen" OnSave="OnSave" Part="attacker" />
            }
        </ChildContent>
    </SectionHeader>
    @* Contenu masqué plutôt que retiré : les cartes d'arme et de groupe gardent leur état replié ou déplié *@
    <div hidden="@(!_expanded)" data-test="attacker-content">
        <MudTextField T="string" Label="@L["Attacker_Name"]" @bind-Value="Attacker.Name" @bind-Value:after="NotifyChanged" />

        <AttackerBoostsEditor Boosts="Attacker.Boosts" SnapShooting="SnapShooting" Changed="NotifyChanged" />

        <div class="wh-subsection-title mt-4" data-test="weapons-title">
            <MudText Typo="Typo.subtitle1">@L["Attacker_Weapons"]</MudText>
            <HelpBubble Lines="@([L["Attacker_WeaponsHelp"]])" />
        </div>

        @{
            var boosts = Attacker.Boosts.ToAttackerBoosts();
            var context = new AttackContext { SnapShooting = SnapShooting };
        }
        @for (int i = 0; i < Attacker.Weapons.Count; i++)
        {
            int index = i;
            var weapon = Attacker.Weapons[index];
            <WeaponEditor @key="weapon" Weapon="weapon" Changed="NotifyChanged"
                          CanMoveUp="index > 0" CanMoveDown="index < Attacker.Weapons.Count - 1"
                          OnMoveUp="() => Move(index, -1)" OnMoveDown="() => Move(index, 1)"
                          OnDuplicate="() => Duplicate(weapon)" OnRemove="() => Remove(weapon)"
                          OnEditKeywords="() => EditKeywords.InvokeAsync(weapon)"
                          Boosts="boosts" Context="context" />
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" OnClick="Add"
                   data-test="add-weapon">@L["Attacker_AddWeapon"]</MudButton>
    </div>
</MudPaper>

@code {
    private bool _expanded = true;

    [Parameter, EditorRequired]
    public AttackerForm Attacker { get; set; } = null!;

    /// <summary>Appelé après chaque modification, pour que la page revalide le scénario.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>Demande l'ouverture du sélecteur de mots-clés pour une arme.</summary>
    [Parameter]
    public EventCallback<WeaponForm> EditKeywords { get; set; }

    /// <summary>Ouvre un attaquant depuis un fichier (bouton affiché seulement si fourni).</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Enregistre l'attaquant seul.</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>Ouvrir et enregistrer indisponibles (simulation en cours).</summary>
    [Parameter]
    public bool FileActionsDisabled { get; set; }

    /// <summary>Enregistrer seul indisponible (saisie de dés illisible).</summary>
    [Parameter]
    public bool SaveDisabled { get; set; }

    /// <summary>Tir en overwatch (situation) : boosts de touche grisés.</summary>
    [Parameter]
    public bool SnapShooting { get; set; }

    private Task NotifyChanged() => Changed.InvokeAsync();

    private Task Add()
    {
        Attacker.Weapons.Add(new WeaponForm());
        return NotifyChanged();
    }

    /// <summary>Change l'ordre de résolution : les armes (leurs pools) sont résolues de haut en bas.</summary>
    private Task Move(int index, int offset)
    {
        int target = index + offset;
        if (target < 0 || target >= Attacker.Weapons.Count)
        {
            return Task.CompletedTask;
        }
        (Attacker.Weapons[index], Attacker.Weapons[target]) = (Attacker.Weapons[target], Attacker.Weapons[index]);
        return NotifyChanged();
    }

    private Task Duplicate(WeaponForm weapon)
    {
        var copy = weapon.Clone();
        copy.Name = L["Attacker_CopyName", weapon.Name];
        Attacker.Weapons.Insert(Attacker.Weapons.IndexOf(weapon) + 1, copy);
        return NotifyChanged();
    }

    private Task Remove(WeaponForm weapon)
    {
        Attacker.Weapons.Remove(weapon);
        return NotifyChanged();
    }
}
