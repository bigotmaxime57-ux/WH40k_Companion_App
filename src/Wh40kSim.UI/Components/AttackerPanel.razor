@*
    Attaquant : nom, boosts (pour toutes ses armes) et profils d'armes, résolus dans l'ordre de la liste. Boutons
    Ouvrir / Enregistrer de l'attaquant seul dans l'en-tête, si la page les fournit, ainsi que Monter / Descendre,
    Dupliquer / Supprimer (comparateur, une carte par attaquant). Au comparateur, le nom est le titre de la carte,
    modifiable sur place (stylo) au lieu d'un champ dans la carte. Repliable sans perdre l'état des cartes qu'il contient.
*@

<MudPaper Elevation="3" Class="pa-4 wh-section wh-attacker" data-test="attacker-panel">
    <SectionHeader Icon="@Icons.Material.Filled.GpsFixed" Title="@L["Attacker_Title"]" TitleContent="@(NameInTitle ? NameTitle : null)">
        <Leading>
            <CollapseToggle @bind-Expanded="_expanded" data-test="toggle-attacker" />
        </Leading>
        <ChildContent>
            @if (OnMoveUp.HasDelegate)
            {
                <MudTooltip Text="@L["Attacker_MoveUp"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(FileActionsDisabled || !CanMoveUp)"
                                   OnClick="OnMoveUp" aria-label="@L["Attacker_MoveUp"]" data-test="move-attacker-up" />
                </MudTooltip>
                <MudTooltip Text="@L["Attacker_MoveDown"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(FileActionsDisabled || !CanMoveDown)"
                                   OnClick="OnMoveDown" aria-label="@L["Attacker_MoveDown"]" data-test="move-attacker-down" />
                </MudTooltip>
            }
            @if (OnOpen.HasDelegate)
            {
                <PartFileActions OpenHelp="@L["Attacker_OpenHelp"]" SaveHelp="@L["Attacker_SaveHelp"]" Disabled="FileActionsDisabled"
                                 SaveDisabled="SaveDisabled" OnOpen="OnOpen" OnSave="OnSave" Part="attacker" />
            }
            @if (OnDuplicate.HasDelegate)
            {
                <MudTooltip Text="@L["Attacker_DuplicateHelp"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Disabled="FileActionsDisabled"
                                   OnClick="OnDuplicate" aria-label="@L["Attacker_DuplicateHelp"]" data-test="duplicate-attacker" />
                </MudTooltip>
            }
            @if (OnRemove.HasDelegate)
            {
                <MudTooltip Text="@L["Attacker_RemoveHelp"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="FileActionsDisabled" Class="wh-delete"
                                   OnClick="OnRemove" aria-label="@L["Attacker_RemoveHelp"]" data-test="remove-attacker" />
                </MudTooltip>
            }
        </ChildContent>
    </SectionHeader>
    @* Contenu masqué plutôt que retiré : les cartes d'arme et de groupe gardent leur état replié ou déplié *@
    <div hidden="@(!_expanded)" data-test="attacker-content">
        @if (!NameInTitle)
        {
            <MudTextField T="string" Label="@L["Attacker_Name"]" @bind-Value="Attacker.Name" @bind-Value:after="NotifyChanged" />
        }

        <AttackerBoostsEditor Boosts="Attacker.Boosts" SnapShooting="SnapShooting" Changed="NotifyChanged" />

        @Situation

        <div class="wh-subsection-title mt-4" data-test="weapons-title">
            <MudText Typo="Typo.subtitle1">@L["Attacker_Weapons"]</MudText>
            <HelpBubble Lines="@([L["Attacker_WeaponsHelp"]])" />
        </div>

        @{
            var boosts = Attacker.Boosts.ToAttackerBoosts();
            var context = new AttackContext { SnapShooting = SnapShooting };
        }
        @for (int i = 0; i < Attacker.Weapons.Count; i++)
        {
            int index = i;
            var weapon = Attacker.Weapons[index];
            @* Comparateur : la carte montre le profil choisi dans la barre des profils (le premier, ou un profil de rechange) *@
            var shown = ShownProfile(weapon);
            <WeaponEditor @key="weapon" Weapon="shown" Changed="() => OnWeaponChanged(weapon, shown)"
                          CanMoveUp="index > 0" CanMoveDown="index < Attacker.Weapons.Count - 1"
                          OnMoveUp="() => Move(index, -1)" OnMoveDown="() => Move(index, 1)"
                          OnDuplicate="() => Duplicate(weapon)" OnRemove="() => Remove(weapon)"
                          OnEditKeywords="() => EditKeywords.InvokeAsync(shown)"
                          Boosts="boosts" Context="context" Profiles="@(Alternatives is null ? null : ProfileBar(weapon))" />
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" OnClick="Add"
                   data-test="add-weapon">@L["Attacker_AddWeapon"]</MudButton>
    </div>
</MudPaper>

@code {
    private bool _expanded = true;

    [Parameter, EditorRequired]
    public AttackerForm Attacker { get; set; } = null!;

    /// <summary>Appelé après chaque modification, pour que la page revalide le scénario.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>Demande l'ouverture du sélecteur de mots-clés pour une arme.</summary>
    [Parameter]
    public EventCallback<WeaponForm> EditKeywords { get; set; }

    /// <summary>Ouvre un attaquant depuis un fichier (bouton affiché seulement si fourni).</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Enregistre l'attaquant seul.</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>Ouvrir et enregistrer indisponibles (simulation en cours).</summary>
    [Parameter]
    public bool FileActionsDisabled { get; set; }

    /// <summary>Enregistrer seul indisponible (saisie de dés illisible).</summary>
    [Parameter]
    public bool SaveDisabled { get; set; }

    /// <summary>Tir en overwatch (situation) : boosts de touche grisés.</summary>
    [Parameter]
    public bool SnapShooting { get; set; }

    /// <summary>
    /// Le nom de l'attaquant sert de titre, modifiable sur place avec le stylo (comparateur, une carte par attaquant) ;
    /// sinon le titre est « Attaquant » et le nom se saisit dans la carte.
    /// </summary>
    [Parameter]
    public bool NameInTitle { get; set; }

    /// <summary>
    /// Profils de rechange par arme (comparateur seulement ; null : pas de profils, Quick sim et Full sim). La carte
    /// d'une arme a alors une barre de profils : un onglet par profil, « Ajouter un profil », suppression d'un profil de
    /// rechange.
    /// </summary>
    [Parameter]
    public Dictionary<WeaponForm, List<WeaponForm>>? Alternatives { get; set; }

    private readonly Dictionary<WeaponForm, WeaponForm> _shownProfile = [];

    /// <summary>Profil affiché dans la carte d'une arme : celui choisi dans la barre, sinon l'arme elle-même (premier profil).</summary>
    private WeaponForm ShownProfile(WeaponForm weapon) =>
        _shownProfile.GetValueOrDefault(weapon) is { } shown && Alternatives?.GetValueOrDefault(weapon)?.Contains(shown) == true ? shown : weapon;

    private RenderFragment ProfileBar(WeaponForm weapon) => @<div class="wh-profile-bar" data-test="profile-bar">
        @{
            var profiles = Alternatives!.GetValueOrDefault(weapon) ?? [];
            var shown = ShownProfile(weapon);
        }
        @if (profiles.Count > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="@(shown == weapon ? Variant.Filled : Variant.Outlined)"
                     OnClick="() => Show(weapon, weapon)" data-test="profile-tab">@weapon.Name</MudChip>
            @foreach (var profile in profiles)
            {
                var current = profile;
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="@(shown == current ? Variant.Filled : Variant.Outlined)"
                         OnClick="() => Show(weapon, current)" OnClose="_ => RemoveProfile(weapon, current)" data-test="profile-tab">@current.Name</MudChip>
            }
        }
        <MudTooltip Text="@L["Weapon_AddProfileHelp"]">
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircleOutline"
                       OnClick="() => AddProfile(weapon)" data-test="add-profile">@L["Weapon_AddProfile"]</MudButton>
        </MudTooltip>
    </div>;

    private void Show(WeaponForm weapon, WeaponForm profile) => _shownProfile[weapon] = profile;

    /// <summary>Nouveau profil de rechange : copie du profil affiché, sous un nom libre, affiché aussitôt.</summary>
    private Task AddProfile(WeaponForm weapon)
    {
        var profiles = Alternatives!.TryGetValue(weapon, out var list) ? list : Alternatives[weapon] = [];
        var copy = ShownProfile(weapon).Clone();
        var taken = profiles.Select(p => p.Name.Trim()).Prepend(weapon.Name.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        int suffix = profiles.Count + 2;
        while (taken.Contains($"{weapon.Name.Trim()} ({suffix})")) suffix++;
        copy.Name = $"{weapon.Name.Trim()} ({suffix})";
        copy.ModelCount = weapon.ModelCount;
        profiles.Add(copy);
        _shownProfile[weapon] = copy;
        return NotifyChanged();
    }

    private Task RemoveProfile(WeaponForm weapon, WeaponForm profile)
    {
        Alternatives!.GetValueOrDefault(weapon)?.Remove(profile);
        if (_shownProfile.GetValueOrDefault(weapon) == profile)
        {
            _shownProfile.Remove(weapon);
        }
        return NotifyChanged();
    }

    /// <summary>
    /// Modification d'une carte : le nombre de porteurs est celui de l'arme, commun à tous ses profils (on choisit le
    /// profil, pas la répartition) ; modifié dans un profil de rechange, il est reporté sur l'arme et ses autres profils.
    /// </summary>
    private Task OnWeaponChanged(WeaponForm weapon, WeaponForm shown)
    {
        if (Alternatives?.GetValueOrDefault(weapon) is { } profiles)
        {
            weapon.ModelCount = shown.ModelCount;
            foreach (var profile in profiles)
            {
                profile.ModelCount = weapon.ModelCount;
            }
        }
        return NotifyChanged();
    }

    /// <summary>Note après le nom dans le titre (comparateur : nombre de variantes) ; null : aucune.</summary>
    [Parameter]
    public string? TitleNote { get; set; }

    /// <summary>Situation propre à l'attaquant, sous ses boosts (comparateur : seulement les conditions qui comptent).</summary>
    [Parameter]
    public RenderFragment? Situation { get; set; }

    /// <summary>Boutons Monter / Descendre dans l'en-tête, si fournis (ordre des attaquants au comparateur).</summary>
    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    private bool _editingName;
    private string _nameDraft = "";

    /// <summary>Titre-nom : texte et stylo, ou champ de saisie pendant la modification (Entrée ou sortie du champ : valider ; Échap : annuler).</summary>
    private RenderFragment NameTitle => @<span class="wh-name-title" data-test="attacker-name-title">
        @if (_editingName)
        {
            <MudTextField T="string" @bind-Value="_nameDraft" Immediate="true" AutoFocus="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="@L["Attacker_Name"]" OnBlur="CommitName" OnKeyDown="OnNameKeyDown" data-test="attacker-name-input" />
        }
        else
        {
            <MudText Typo="Typo.h6" data-test="attacker-name">@(string.IsNullOrWhiteSpace(Attacker.Name) ? L["Attacker_Title"] : Attacker.Name)</MudText>
            @if (TitleNote is not null)
            {
                <MudText Typo="Typo.caption" Class="wh-muted" data-test="attacker-title-note">@TitleNote</MudText>
            }
            <MudTooltip Text="@L["Attacker_Rename"]">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="FileActionsDisabled" OnClick="StartRename"
                               aria-label="@L["Attacker_Rename"]" data-test="rename-attacker" />
            </MudTooltip>
        }
    </span>;

    private void StartRename()
    {
        _nameDraft = Attacker.Name;
        _editingName = true;
    }

    private async Task CommitName()
    {
        if (!_editingName)
        {
            return;
        }
        _editingName = false;
        if (_nameDraft != Attacker.Name)
        {
            Attacker.Name = _nameDraft.Trim();
            await NotifyChanged();
        }
    }

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitName();
        }
        else if (e.Key == "Escape")
        {
            _editingName = false;
        }
    }

    /// <summary>Carte dépliée à sa première apparition (au comparateur, seul un attaquant ajouté à la main l'est).</summary>
    [Parameter]
    public bool InitiallyExpanded { get; set; } = true;

    /// <summary>Bouton Dupliquer dans l'en-tête, si fourni (comparateur).</summary>
    [Parameter]
    public EventCallback OnDuplicate { get; set; }

    /// <summary>Bouton Supprimer dans l'en-tête, si fourni (comparateur).</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    protected override void OnInitialized() => _expanded = InitiallyExpanded;

    private Task NotifyChanged() => Changed.InvokeAsync();

    private Task Add()
    {
        Attacker.Weapons.Add(new WeaponForm());
        return NotifyChanged();
    }

    /// <summary>Change l'ordre de résolution : les armes (leurs pools) sont résolues de haut en bas.</summary>
    private Task Move(int index, int offset)
    {
        int target = index + offset;
        if (target < 0 || target >= Attacker.Weapons.Count)
        {
            return Task.CompletedTask;
        }
        (Attacker.Weapons[index], Attacker.Weapons[target]) = (Attacker.Weapons[target], Attacker.Weapons[index]);
        return NotifyChanged();
    }

    private Task Duplicate(WeaponForm weapon)
    {
        var copy = weapon.Clone();
        copy.Name = L["Attacker_CopyName", weapon.Name];
        Attacker.Weapons.Insert(Attacker.Weapons.IndexOf(weapon) + 1, copy);
        return NotifyChanged();
    }

    private Task Remove(WeaponForm weapon)
    {
        Attacker.Weapons.Remove(weapon);
        return NotifyChanged();
    }
}
