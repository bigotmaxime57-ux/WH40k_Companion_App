@*
    Saisie du comparateur, construite comme le Full sim : bandeau (fichier de comparaison, puis réglages et lancement),
    Situation commune en pleine largeur, puis les attaquants comparés (une carte repliable chacun) et le défenseur
    commun côte à côte. Défenseur et situation propres au comparateur (Session.Comparison), repris du scénario courant
    à la première ouverture. À la fin du calcul, l'écran des résultats s'ouvre ; annulé, on reste ici.
*@
@page "/comparison"
@implements IAsyncDisposable

<MudStack Spacing="3" Class="pa-4 wh-page">
    <MudPaper Elevation="3" Class="pa-3 wh-section wh-banner" data-test="banner">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
            <ScenarioToolbar Running="Running" CanSave="CanSave" FileLabel="@FileLabel" OnNew="NewAsync" OnOpen="OpenAsync" OnSave="SaveAsync"
                             NewHelp="@L["Comparison_NewHelp"]" OpenHelp="@L["Comparison_OpenHelp"]" SaveHelp="@L["Comparison_SaveHelp"]" />
            @if (State.Result is not null && !Running)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="ShowResults" data-test="show-results">@L["FullSim_ShowResults"]</MudButton>
            }
        </MudStack>
        <MudDivider Class="my-2" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <div style="flex: 1 1 auto">
                <SimulationPanel Banner="true" @bind-Iterations="State.Iterations" @bind-Seed="State.Seed" CanRun="CanRun" Running="Running"
                                 Progress="Progress" OnRun="RunAsync" OnCancel="Cancel" />
            </div>
            <MudText Typo="Typo.body2" data-test="round-plan">@RoundPlanLabel</MudText>
            <HelpBubble Lines="@([L["Comparison_RoundsHelp"]])" />
        </MudStack>
    </MudPaper>
    <PhoneRunBar @bind-Iterations="State.Iterations" CanRun="CanRun" Running="Running" Progress="Progress" OnRun="RunAsync" OnCancel="Cancel" />

    @if (Message is not null)
    {
        <MudAlert Severity="MessageSeverity" ShowCloseIcon="true" CloseIconClicked="ClearMessage" data-test="message">@Message</MudAlert>
    }
    <ScenarioErrors Errors="Errors" Warnings="Warnings" HasDiceErrors="HasDiceErrors" />

    <MudGrid Spacing="3">
        <MudItem xs="12">
            <ContextPanel Context="Form.Context" Reference="Reference" Changed="OnChanged" />
        </MudItem>
        <MudItem xs="12" md="7">
            <MudStack Spacing="3" data-test="comparison-attackers">
                <div class="wh-subsection-title">
                    <MudText Typo="Typo.h6">@L["Comparison_Attackers", Form.Attackers.Count]</MudText>
                    <HelpBubble Lines="@([L["Comparison_AttackersHelp"]])" />
                </div>
                @for (int i = 0; i < Form.Attackers.Count; i++)
                {
                    int index = i;
                    var current = Form.Attackers[index];
                    @* Dépliée : la première carte (celle de départ) et celles ajoutées à la main *@
                    <div @key="current" data-test="comparison-attacker">
                        <AttackerPanel Attacker="current" NameInTitle="true" InitiallyExpanded="@(index == 0 || _expandOnAdd.Contains(current))"
                                       Changed="() => OnAttackerChanged(current)" EditKeywords="EditKeywords"
                                       OnOpen="() => OpenAttackerAsync(current)" OnSave="() => SaveAttackerAsync(current)"
                                       CanMoveUp="index > 0" CanMoveDown="index < Form.Attackers.Count - 1"
                                       OnMoveUp="() => Move(index, -1)" OnMoveDown="() => Move(index, 1)"
                                       OnDuplicate="() => Duplicate(current)" OnRemove="() => Remove(current)"
                                       FileActionsDisabled="Running" SnapShooting="Form.Context.SnapShooting" />
                    </div>
                }
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentPaste" Disabled="Running"
                               OnClick="AddFromScenario" data-test="add-from-scenario">@L["Comparison_AddFromScenario"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" Disabled="Running"
                               OnClick="AddFromFilesAsync" data-test="add-from-files">@L["Comparison_AddFromFiles"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="Running"
                               OnClick="AddNew" data-test="add-new-attacker">@L["Comparison_AddNew"]</MudButton>
                </MudStack>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudStack Spacing="2">
                <DefenderPanel Defender="Form.Defender" Changed="OnDefenderChanged" SnapShooting="Form.Context.SnapShooting"
                               OnOpen="OpenDefenderAsync" OnSave="SaveDefenderAsync" FileActionsDisabled="Running"
                               ShowPrecisionTargets="Reference.PrecisionTargetGroup is not null" PrecisionTarget="@Form.Context.PrecisionTarget"
                               PrecisionTargetChanged="OnPrecisionTargetChanged" />
                <div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="Running"
                               OnClick="TakeDefenderFromScenarioAsync" data-test="defender-from-scenario">@L["Comparison_DefenderFromScenario"]</MudButton>
                    <HelpBubble Lines="@([L["Comparison_DefenderFromScenarioHelp"]])" />
                </div>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudStack>

<KeywordDrawer Weapon="KeywordWeapon" OnClose="CloseKeywords" Changed="OnKeywordsChanged" />
