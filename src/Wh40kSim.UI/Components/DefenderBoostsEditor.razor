@*
    Boosts du défenseur contre les attaques qui le visent : couvert, caractéristiques des attaques (sans plafond) et
    modificateurs aux jets des attaquants (±1 au total). Valeurs du point de vue de l'attaquant (négatif = moins bon pour
    lui) ; le moteur les cumule avec les boosts de l'attaquant.
*@

<BoostSection ActiveCount="Boosts.ActiveCount" Help="@([L["Help_DefenderBoosts"], L["Help_Cover"], L["Help_Roll"], L["Help_DefenderDamage"]])"
              data-test="defender-boosts">
    <MudText Typo="Typo.caption" Class="wh-boost-row-title">@L["Boosts_Hit"]</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudCheckBox T="bool" Label="@L["Defender_InCover"]" @bind-Value="Boosts.InCover" @bind-Value:after="NotifyChanged" data-test="in-cover" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_DefenderSkill"]" Min="-6" Max="6" @bind-Value="Boosts.Skill" @bind-Value:after="NotifyChanged"
                             data-test="defender-skill-modifier" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Defender_HitModifier"]" Min="-3" Max="3" @bind-Value="Boosts.HitRoll" @bind-Value:after="NotifyChanged" />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.caption" Class="wh-boost-row-title">@L["Boosts_WoundAndDamage"]</MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Defender_WoundModifier"]" Min="-3" Max="3" @bind-Value="Boosts.WoundRoll" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_DefenderAp"]" Min="-6" Max="6" @bind-Value="Boosts.Ap" @bind-Value:after="NotifyChanged" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="int" Label="@L["Modifier_DefenderDamage"]" Min="-6" Max="6" @bind-Value="Boosts.Damage" @bind-Value:after="NotifyChanged"
                             data-test="defender-damage-modifier" />
        </MudItem>
    </MudGrid>
</BoostSection>

@code {
    [Parameter, EditorRequired]
    public DefenderBoostsForm Boosts { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    private Task NotifyChanged() => Changed.InvokeAsync();
}
