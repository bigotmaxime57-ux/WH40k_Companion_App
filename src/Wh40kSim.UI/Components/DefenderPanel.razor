@* Défenseur : ses groupes d'allocation, dans l'ordre où ils encaissent (le premier d'abord). *@

<MudPaper Elevation="3" Class="pa-4 wh-section">
    <SectionHeader Icon="@Icons.Material.Filled.Shield" Title="@L["Defender_Title"]" />
    <MudTextField T="string" Label="@L["Defender_Name"]" @bind-Value="Defender.Name" @bind-Value:after="NotifyChanged" />

    @* Couvert et modificateurs aux jets subis ; les modifications de caractéristiques se saisissent dans la Situation *@
    <SubSection Title="@L["Defender_AgainstUnit"]" Help="@([L["Help_Cover"], L["Help_Roll"], L["Help_DefenderCharacteristics"]])"
                data-test="defender-modifiers">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudCheckBox T="bool" Label="@L["Defender_InCover"]" @bind-Value="Defender.InCover" @bind-Value:after="NotifyChanged" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" Label="@L["Defender_HitModifier"]" Min="-3" Max="3"
                                 @bind-Value="Defender.HitModifier" @bind-Value:after="NotifyChanged" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" Label="@L["Defender_WoundModifier"]" Min="-3" Max="3"
                                 @bind-Value="Defender.WoundModifier" @bind-Value:after="NotifyChanged" />
            </MudItem>
        </MudGrid>
    </SubSection>

    <div class="wh-subsection-title mt-4">
        <MudText Typo="Typo.subtitle1">@L["Defender_Groups"]</MudText>
        <HelpBubble Lines="@([L["Defender_GroupsHelp"]])" />
    </div>

    @for (int i = 0; i < Defender.Groups.Count; i++)
    {
        int index = i;
        var group = Defender.Groups[index];
        <ModelGroupEditor @key="group" Group="group" Number="index + 1" Changed="NotifyChanged"
                          CanMoveUp="CanMove(index, -1)" CanMoveDown="CanMove(index, 1)"
                          OnMoveUp="() => Move(index, -1)" OnMoveDown="() => Move(index, 1)" OnRemove="() => Remove(group)" />
    }

    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" OnClick="Add"
               data-test="add-group">@L["Defender_AddGroup"]</MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public DefenderForm Defender { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>
    /// Après chaque modification, les PERSONNAGES sont remis après les gardes du corps (règle 05.03, portée par le Core) :
    /// cocher PERSONNAGE envoie le groupe en fin de liste, décocher le replace avant les PERSONNAGES.
    /// </summary>
    private Task NotifyChanged()
    {
        Defender.Groups = AllocationOrder.Arrange(Defender.Groups, g => g.IsCharacter);
        return Changed.InvokeAsync();
    }

    /// <summary>Nouveau groupe : valeurs par défaut du Core, et l'Endurance du dernier garde du corps (à défaut, du dernier groupe).</summary>
    private Task Add()
    {
        var group = new ModelGroupForm();
        var previous = Defender.Groups.LastOrDefault(g => !g.IsCharacter) ?? Defender.Groups.LastOrDefault();
        if (previous is not null)
        {
            group.Toughness = previous.Toughness;
        }
        Defender.Groups.Add(group);
        return NotifyChanged();
    }

    /// <summary>Déplacement possible : dans la liste, et sans faire passer un PERSONNAGE devant un garde du corps.</summary>
    private bool CanMove(int index, int offset)
    {
        int target = index + offset;
        if (target < 0 || target >= Defender.Groups.Count)
        {
            return false;
        }
        var isCharacter = Defender.Groups.Select(g => g.IsCharacter).ToArray();
        (isCharacter[index], isCharacter[target]) = (isCharacter[target], isCharacter[index]);
        return AllocationOrder.IsValid(isCharacter);
    }

    private Task Move(int index, int offset)
    {
        if (!CanMove(index, offset))
        {
            return Task.CompletedTask;
        }
        int target = index + offset;
        (Defender.Groups[index], Defender.Groups[target]) = (Defender.Groups[target], Defender.Groups[index]);
        return NotifyChanged();
    }

    private Task Remove(ModelGroupForm group)
    {
        Defender.Groups.Remove(group);
        return NotifyChanged();
    }
}
