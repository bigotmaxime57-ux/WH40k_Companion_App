@*
    Écran des résultats du Full sim : retour à la saisie et en-tête (scénario, simulations, graine, durée), puis un
    onglet par graphique ou tableau de bord. La barre d'onglets reste visible au défilement ; une fois collée en haut,
    elle montre un retour compact (flèche ronde), le bouton du haut étant sorti de l'écran. Sur téléphone, la barre
    d'onglets est remplacée par un bouton qui ouvre la liste des onglets. Lit Session.FullSim.Result
    sans aucun calcul ; sans résultat, renvoie à la saisie.
*@
@page "/full-sim/results"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ScenarioSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* wh-report : couleur principale du thème partout, sans couleur de camp (voir wh40ksim.css) *@
<MudStack Spacing="3" Class="pa-4 wh-page wh-report">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEntry"
                   data-test="back-to-entry">@L["FullSim_BackToEntry"]</MudButton>
        @if (Result is not null)
        {
            <MudText Typo="Typo.body2" data-test="results-header">
                @L["FullSim_ResultsHeader", Result.Scenario.Attacker.Name, Result.Scenario.Defender.Name,
                    Result.Iterations.ToString("N0"), Result.Seed, Result.Elapsed.TotalSeconds.ToString("F2")]
                <OverwatchChip Result="Result" />
            </MudText>
        }
    </MudStack>

    @if (Result is null)
    {
        <MudAlert Severity="Severity.Info" data-test="no-result">@L["FullSim_NoResult"]</MudAlert>
    }
    else
    {
        @if (Session.IsStale(Session.FullSim))
        {
            <MudAlert Severity="Severity.Warning" data-test="stale-results-banner">@L["StaleResults_Banner"]</MudAlert>
        }
        @* Repère juste au-dessus de la barre d'onglets : quand il passe sous la barre de titre, la barre est collée *@
        <div @ref="_stickySentinel"></div>
        <div @ref="_tabsHost" data-test="results-tabs-host">
            @*
                Sur téléphone (wh40ksim.css), la barre d'onglets est masquée : à sa place, un bouton au nom de l'onglet affiché
                ouvre la liste des onglets. Il reste collé sous la barre de titre, avec le retour compact une fois collé.
            *@
            <div class="wh-tabs-phone" data-test="tabs-phone">
                <div class="wh-tabs-back">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" Color="Color.Primary"
                                   Size="Size.Small" OnClick="BackToEntry" aria-label="@L["FullSim_BackToEntry"]" />
                </div>
                <MudMenu Label="@Tabs[Session.FullSim.ResultsTab].Name" StartIcon="@Tabs[Session.FullSim.ResultsTab].Icon"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                         AriaLabel="@L["FullSim_TabsMenu"]" Class="wh-tabs-phone-menu" data-test="tabs-phone-menu">
                    @for (int i = 0; i < Tabs.Length; i++)
                    {
                        int index = i;
                        <MudMenuItem Icon="@Tabs[index].Icon" OnClick="@(() => Session.FullSim.ResultsTab = index)"
                                     data-test="@($"tabs-phone-{index}")">@Tabs[index].Name</MudMenuItem>
                    }
                </MudMenu>
            </div>
            @* Onglet retenu dans la session pour ce résultat (retrouvé en revenant de la saisie, remis à zéro par un nouveau calcul) *@
            <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4 wh-tab-panels" Class="wh-results-tabs"
                     HeaderPosition="TabHeaderPosition.Before" @bind-ActivePanelIndex="Session.FullSim.ResultsTab">
                <Header>
                    <div class="wh-tabs-back">
                        <MudTooltip Text="@L["FullSim_BackToEntry"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" Color="Color.Primary"
                                           Size="Size.Small" OnClick="BackToEntry" aria-label="@L["FullSim_BackToEntry"]"
                                           data-test="back-to-entry-compact" />
                        </MudTooltip>
                    </div>
                </Header>
                <ChildContent>
            <MudTabPanel Text="@Tabs[0].Name" Icon="@Tabs[0].Icon" data-test="tab-distributions">
                <SummaryTiles Result="Result" Extended="_extended" />
                @if (Result.ProbabilityWipe > 0)
                {
                    <div class="wh-subsection-title">
                        <MudSwitch T="bool" Color="Color.Primary" Label="@L["Results_Extended"]" @bind-Value="_extended" data-test="extended" />
                        <HelpBubble Lines="@([L["Help_Margin"], L["Help_MarginChart"]])" />
                    </div>
                    @if (_extended)
                    {
                        <MudText Typo="Typo.caption" Class="wh-muted d-block mt-1" data-test="excess-explanation">
                            @L["Results_ExtendedHelp", (Result.ExcessProfile with { Count = 1 }).Describe()]
                        </MudText>
                    }
                }
                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" lg="6">
                        <MudPaper Elevation="2" Class="pa-4 wh-section">
                            <SectionHeader Icon="@Icons.Material.Filled.PersonOff" Title="@L["Results_Kills"]" />
                            <HistogramChart Distribution="@(_extended ? Result.ExtendedKills : Result.Kills)" Title="@L["Results_Kills"]"
                                            ValueTitle="@L["Chart_KillsValue"]" UnitSize="Result.TotalModels" Extended="_extended"
                                            MeanHelp="@ExtendedMeanHelp(Result.Kills, Result.KillMarginWhenWiped, Result.ExtendedKills)" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" lg="6">
                        <MudPaper Elevation="2" Class="pa-4 wh-section">
                            <SectionHeader Icon="@Icons.Material.Filled.HeartBroken" Title="@L["Results_Damage"]" />
                            <HistogramChart Distribution="@(_extended ? Result.ExtendedDamage : Result.Damage)" Title="@L["Results_Damage"]"
                                            ValueTitle="@L["Chart_DamageValue"]" UnitSize="Result.TotalWounds" Extended="_extended"
                                            MeanHelp="@ExtendedMeanHelp(Result.Damage, Result.DamageMarginWhenWiped, Result.ExtendedDamage)" />
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="@Tabs[1].Name" Icon="@Tabs[1].Icon" data-test="tab-groups">
                <GroupsReport Result="Result" />
            </MudTabPanel>
            <MudTabPanel Text="@Tabs[2].Name" Icon="@Tabs[2].Icon" data-test="tab-weapons">
                <WeaponsReport Result="Result" />
            </MudTabPanel>
                </ChildContent>
            </MudTabs>
        </div>
    }
</MudStack>

@code {
    /// <summary>Hauteur de la barre de titre compacte, sous laquelle la barre d'onglets se colle (même valeur dans le CSS).</summary>
    private const int AppBarHeight = 48;

    private bool _extended;
    private ElementReference _stickySentinel;
    private ElementReference _tabsHost;
    private IJSObjectReference? _module;
    private IJSObjectReference? _stickyWatch;

    private SimulationResult? Result => Session.FullSim.Result;

    /// <summary>Nom et icône de chaque onglet, dans l'ordre : barre d'onglets et liste du téléphone.</summary>
    private (string Name, string Icon)[] Tabs =>
    [
        (L["FullSim_TabDistributions"], Icons.Material.Filled.BarChart),
        (L["FullSim_TabGroups"], Icons.Material.Filled.Shield),
        (L["FullSim_TabWeapons"], WeaponIcons.For(WeaponType.Ranged)),
    ];

    private void BackToEntry() => Navigation.NavigateTo(AppRoutes.FullSim);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Result is null)
        {
            return;
        }
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Wh40kSim.UI/wh40ksim.js");
            if (_module is not null)
            {
                _stickyWatch = await _module.InvokeAsync<IJSObjectReference>("watchSticky", _stickySentinel, _tabsHost, AppBarHeight);
            }
        }
        catch (JSException)
        {
            // Pas d'observation possible : la barre reste collante, seul le retour compact ne s'affiche pas
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_stickyWatch is not null) await _stickyWatch.InvokeVoidAsync("dispose");
            if (_stickyWatch is not null) await _stickyWatch.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // L'interface est déjà fermée : rien à détacher
        }
    }

    /// <summary>
    /// Pourquoi la moyenne marge comprise n'est pas « moyenne + marge » : la marge des tuiles ne compte que les
    /// simulations où l'unité est détruite. Toutes les valeurs viennent du résultat, rien n'est recalculé ici.
    /// </summary>
    private string ExtendedMeanHelp(DiscreteDistribution real, double marginWhenWiped, DiscreteDistribution extended) =>
        L["Help_ExtendedMean", real.Mean.ToString("F2"), marginWhenWiped.ToString("F2"),
            Result!.ProbabilityWipe.ToString("P1"), extended.Mean.ToString("F2")];
}
