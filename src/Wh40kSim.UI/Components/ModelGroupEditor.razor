@*
    Un groupe d'allocation (figurines aux mêmes caractéristiques, ou un PERSONNAGE), dans une carte découpée comme celle
    d'une arme : en-tête (numéro d'ordre, nom, nombre de figurines, case PERSONNAGE, boutons monter / descendre /
    dupliquer / supprimer), puis la ligne « Profil » (Endurance, PV, sauvegarde) et la ligne « Protections » (invulnérable, insensible
    à la douleur, réduction de dégâts), séparées par un filet, libellés alignés. Replié : résumé du Core. Filet plus
    large et étiquette pour un PERSONNAGE. Avec une arme Precision, une cible sur chaque PERSONNAGE (même seul) : rouge
    clignotante pour celui que Precision vise, grise pour les autres (un clic le choisit) ; même réglage que la liste de
    la Situation (qui n'apparaît qu'à partir de deux PERSONNAGES).
*@

<MudPaper Outlined="true" Class="@($"pa-4 my-3 wh-subcard {(Group.IsCharacter ? "wh-subcard-character" : "")}")" data-test="group">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <CollapseToggle @bind-Expanded="_expanded" data-test="toggle-group" />
        <span class="wh-group-number">@Number</span>
        @if (PrecisionTarget is { } isTarget)
        {
            <MudTooltip Text="@PrecisionTooltip(isTarget)">
                <MudIconButton Icon="@Icons.Material.Filled.GpsFixed" Size="Size.Small"
                               Class="@(isTarget ? "wh-precision-target wh-precision-target-active" : "wh-precision-target")"
                               OnClick="OnPrecisionTargetClick" aria-label="@PrecisionTooltip(isTarget)"
                               aria-pressed="@(isTarget ? "true" : "false")" data-test="precision-target-toggle" />
            </MudTooltip>
        }
        @if (_expanded)
        {
            <div class="wh-card-name">
                <MudTextField T="string" Label="@L["Group_Name"]" Value="Group.Name" ValueChanged="RenameAsync" data-test="group-name" />
            </div>
            <div class="wh-card-count">
                <MudNumericField T="int" Label="@L["Group_Count"]" Min="1" @bind-Value="Group.Count" @bind-Value:after="NotifyChanged" />
            </div>
            <MudCheckBox T="bool" Label="@L["Group_IsCharacter"]" @bind-Value="Group.IsCharacter" @bind-Value:after="NotifyChanged"
                         Class="wh-character-check" data-test="is-character" />
        }
        else
        {
            <MudText Typo="Typo.body1" Class="wh-summary" data-test="group-summary">@Group.ToModelGroup().Describe()</MudText>
            @if (Group.IsCharacter)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="wh-character-chip">@L["Group_IsCharacter"]</MudChip>
            }
        }
        <MudTooltip Text="@L["Defender_MoveUp"]">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(!CanMoveUp)" OnClick="OnMoveUp" data-test="move-up" />
        </MudTooltip>
        <MudTooltip Text="@L["Defender_MoveDown"]">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(!CanMoveDown)" OnClick="OnMoveDown" data-test="move-down" />
        </MudTooltip>
        <MudTooltip Text="@L["Defender_DuplicateGroup"]">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="OnDuplicate" data-test="duplicate-group" />
        </MudTooltip>
        <MudTooltip Text="@L["Defender_RemoveGroup"]">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="wh-delete" OnClick="OnRemove" data-test="remove-group" />
        </MudTooltip>
    </MudStack>

    @if (_expanded)
    {
        <div class="wh-card-row">
            <MudText Typo="Typo.subtitle2" Class="wh-card-row-label">@L["Group_Profile"]</MudText>
            <div class="wh-stat-line" style="--wh-cols: 3">
                <MudNumericField T="int" Label="@L["Group_Toughness"]" Min="1" @bind-Value="Group.Toughness" @bind-Value:after="NotifyChanged"
                                 data-test="toughness" />
                <MudNumericField T="int" Label="@L["Group_Wounds"]" Min="1" @bind-Value="Group.Wounds" @bind-Value:after="NotifyChanged" />
                <MudSelect T="int" Label="@L["Group_Save"]" @bind-Value="Group.Save" @bind-Value:after="NotifyChanged">
                    @foreach (int value in TwoToSix)
                    {
                        <MudSelectItem T="int" Value="value">@($"{value}+")</MudSelectItem>
                    }
                    <MudSelectItem T="int" Value="7">@L["Group_None"]</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <div class="wh-card-row">
            <MudText Typo="Typo.subtitle2" Class="wh-card-row-label">@L["Group_Protections"]</MudText>
            <div class="wh-stat-line" style="--wh-cols: 3">
                <MudSelect T="int" Label="@L["Group_InvulnerableSave"]" @bind-Value="InvulnerableChoice" @bind-Value:after="NotifyChanged">
                    <MudSelectItem T="int" Value="None">@L["Group_None"]</MudSelectItem>
                    @foreach (int value in TwoToSix)
                    {
                        <MudSelectItem T="int" Value="value">@($"{value}++")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Label="@L["Group_FeelNoPain"]" @bind-Value="FeelNoPainChoice" @bind-Value:after="NotifyChanged">
                    <MudSelectItem T="int" Value="None">@L["Group_None"]</MudSelectItem>
                    @foreach (int value in TwoToSix)
                    {
                        <MudSelectItem T="int" Value="value">@($"{value}+")</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" Label="@L["Group_DamageReduction"]" Min="0" @bind-Value="Group.DamageReduction" @bind-Value:after="NotifyChanged" />
            </div>
        </div>
    }
</MudPaper>

@code {
    private static readonly int[] TwoToSix = [2, 3, 4, 5, 6];

    /// <summary>Valeur des listes déroulantes pour « aucune » (le formulaire utilise null).</summary>
    private const int None = 0;

    private bool _expanded = true;

    [Parameter, EditorRequired]
    public ModelGroupForm Group { get; set; } = null!;

    /// <summary>Position dans l'ordre d'allocation (1 = encaisse en premier).</summary>
    [Parameter]
    public int Number { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public EventCallback OnDuplicate { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>
    /// Cible de Precision : null = pas de cible affichée (pas un PERSONNAGE, ou le choix ne compte pas) ; vrai = ce
    /// PERSONNAGE est visé ; faux = un autre l'est.
    /// </summary>
    [Parameter]
    public bool? PrecisionTarget { get; set; }

    /// <summary>La cible visée vient du choix « premier PERSONNAGE » par défaut (et non d'un choix explicite).</summary>
    [Parameter]
    public bool PrecisionTargetIsDefault { get; set; }

    /// <summary>Clic sur la cible : choisir ce PERSONNAGE, ou revenir au choix par défaut s'il était déjà choisi.</summary>
    [Parameter]
    public EventCallback OnPrecisionTargetClick { get; set; }

    /// <summary>Renommage (ancien nom, nouveau nom) : la cible de Precision suit le PERSONNAGE renommé.</summary>
    [Parameter]
    public EventCallback<(string OldName, string NewName)> Renamed { get; set; }

    private string PrecisionTooltip(bool isTarget) =>
        !isTarget ? L["Group_PrecisionChoose"] : PrecisionTargetIsDefault ? L["Group_PrecisionDefault"] : L["Group_PrecisionChosen"];

    private async Task RenameAsync(string name)
    {
        string old = Group.Name;
        Group.Name = name;
        await Renamed.InvokeAsync((old, name));
        await NotifyChanged();
    }

    private int InvulnerableChoice
    {
        get => Group.InvulnerableSave ?? None;
        set => Group.InvulnerableSave = value == None ? null : value;
    }

    private int FeelNoPainChoice
    {
        get => Group.FeelNoPain ?? None;
        set => Group.FeelNoPain = value == None ? null : value;
    }

    private Task NotifyChanged() => Changed.InvokeAsync();
}
