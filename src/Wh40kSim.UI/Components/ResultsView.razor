@*
    Résultats d'une simulation : tuiles de synthèse, pertes par groupe et tableaux de distribution. Mise en forme
    uniquement : tous les chiffres viennent de SimulationResult (Wh40kSim.Simulation).
*@

<MudPaper Elevation="3" Class="pa-4 wh-section" data-test="results">
    <SectionHeader Icon="@Icons.Material.Filled.Assessment" Title="@L["Results_Title"]"
                   Help="@([L["Help_Wipe", SummaryTiles.WipeUnreliableBelow.ToString("P0"), SummaryTiles.WipeReliableAbove.ToString("P0")], L["Help_Results"]])" />
    <MudText Typo="Typo.caption" GutterBottom="true" data-test="results-header">
        @L["Results_Header", Result.Iterations.ToString("N0"), Result.Elapsed.TotalSeconds.ToString("F2"), Result.Seed]
    </MudText>

    <SummaryTiles Result="Result" Extended="_extended" />

    @if (Result.ProbabilityWipe > 0)
    {
        <div class="wh-subsection-title">
            <MudSwitch T="bool" Color="Color.Primary" Label="@L["Results_Extended"]" @bind-Value="_extended" data-test="extended" />
            <HelpBubble Lines="@([L["Help_Margin"], L["Help_MarginTable"]])" />
        </div>
        @if (_extended)
        {
            <MudText Typo="Typo.caption" Class="wh-muted d-block mt-1 mb-2" data-test="excess-explanation">
                @L["Results_ExtendedHelp", ExcessModel]
            </MudText>
        }
    }

    <MudText Typo="Typo.subtitle2" Class="mt-3">@L["Results_LossesPerGroup"]</MudText>
    <MudSimpleTable Dense="true" Class="mb-3">
        <tbody>
            @for (int g = 0; g < Result.Scenario.Defender.Groups.Count; g++)
            {
                var group = Result.Scenario.Defender.Groups[g];
                <tr>
                    <td>@group.Name</td>
                    <td class="wh-number">@Result.MeanKilledInGroup(g).ToString("F2") / @group.Count</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <DistributionTable Title="@L["Results_Kills"]" ValueHeader="@L["Results_KillsShort"]" Distribution="Kills" UnitSize="@(_extended ? Result.TotalModels : null)" />
    <DistributionTable Title="@L["Results_Damage"]" ValueHeader="@L["Results_DamageShort"]" Distribution="Damage" UnitSize="@(_extended ? Result.TotalWounds : null)" />
</MudPaper>

@code {
    private bool _extended;

    [Parameter, EditorRequired]
    public SimulationResult Result { get; set; } = null!;

    /// <summary>Profil des figurines virtuelles de la marge (premier garde du corps), décrit pour une figurine.</summary>
    private string ExcessModel => (Result.ExcessProfile with { Count = 1 }).Describe();

    /// <summary>Distributions des tableaux : réelles, ou prolongées au-delà de la destruction de l'unité (marge).</summary>
    private DiscreteDistribution Kills => _extended ? Result.ExtendedKills : Result.Kills;

    private DiscreteDistribution Damage => _extended ? Result.ExtendedDamage : Result.Damage;
}
