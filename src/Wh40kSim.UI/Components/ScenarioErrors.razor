@*
    Ce qui empêche de lancer la simulation : saisies de dés invalides, puis incohérences relevées par le Core. Les
    avertissements du Core (ce qui ne jouera pas) n'empêchent pas de lancer : à part, dans une autre teinte.
*@

@if (HasDiceErrors)
{
    <MudAlert Severity="Severity.Error" data-test="dice-errors">@L["Errors_Dice"]</MudAlert>
}
else if (Errors.Count > 0)
{
    <MudAlert Severity="Severity.Warning" data-test="scenario-errors">
        <MudText Typo="Typo.subtitle2">@L["Errors_Title"]</MudText>
        <ul class="mb-0">
            @foreach (string error in Errors)
            {
                <li>@error</li>
            }
        </ul>
    </MudAlert>
}
@if (!HasDiceErrors && Warnings.Count > 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-2" data-test="scenario-warnings">
        <MudText Typo="Typo.subtitle2">@L["Warnings_Title"]</MudText>
        <ul class="mb-0">
            @foreach (string warning in Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    </MudAlert>
}

@code {
    /// <summary>Messages de <c>Scenario.Validate()</c> (en français, traduits avec les messages du Core en phase 7).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Errors { get; set; } = [];

    /// <summary>Messages de <c>Scenario.Warnings()</c> : n'empêchent pas de lancer.</summary>
    [Parameter]
    public IReadOnlyList<string> Warnings { get; set; } = [];

    [Parameter]
    public bool HasDiceErrors { get; set; }
}
