@* Barre des fichiers d'un écran de saisie : Nouveau, Ouvrir, Enregistrer et nom du fichier (« * » si modifié).
   Sur téléphone, les boutons n'affichent que leur icône et le nom du fichier passe à la ligne (wh40ksim.css). *@

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="wh-toolbar">
    <MudTooltip Text="@L["Toolbar_NewHelp"]">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NoteAdd" Disabled="Running" OnClick="OnNew"
                   aria-label="@L["Toolbar_New"]" data-test="new"><span class="wh-toolbar-label">@L["Toolbar_New"]</span></MudButton>
    </MudTooltip>
    <MudTooltip Text="@L["Toolbar_OpenHelp"]">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen" Disabled="Running" OnClick="OnOpen"
                   aria-label="@L["Toolbar_Open"]" data-test="open"><span class="wh-toolbar-label">@L["Toolbar_Open"]</span></MudButton>
    </MudTooltip>
    <MudTooltip Text="@L["Toolbar_SaveHelp"]">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanSave)" OnClick="OnSave"
                   aria-label="@L["Toolbar_Save"]" data-test="save"><span class="wh-toolbar-label">@L["Toolbar_Save"]</span></MudButton>
    </MudTooltip>
    <MudText Typo="Typo.body2" Class="wh-toolbar-file" data-test="file-name">@FileLabel</MudText>
</MudStack>

@code {
    [Parameter]
    public bool Running { get; set; }

    [Parameter]
    public bool CanSave { get; set; }

    [Parameter]
    public string FileLabel { get; set; } = "";

    [Parameter]
    public EventCallback OnNew { get; set; }

    [Parameter]
    public EventCallback OnOpen { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }
}
