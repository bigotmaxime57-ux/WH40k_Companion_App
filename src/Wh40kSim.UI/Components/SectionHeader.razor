@* En-tête de section : icône du thème, titre, bulle d'aide éventuelle, et éventuellement des actions à droite. *@

<div class="wh-section-header">
    <MudIcon Icon="@Icon" />
    <MudText Typo="Typo.h6">@Title</MudText>
    @if (Help is not null)
    {
        <HelpBubble Lines="Help" />
    }
    @if (ChildContent is not null)
    {
        <div class="wh-section-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Icon { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Explications de la section, derrière une bulle « ? » à côté du titre.</summary>
    [Parameter]
    public IReadOnlyList<string>? Help { get; set; }

    /// <summary>Actions affichées à droite du titre (boutons…).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
