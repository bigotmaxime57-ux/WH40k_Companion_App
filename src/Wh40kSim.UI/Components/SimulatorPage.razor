@*
    Écran « Quick sim » : saisie du scénario à gauche (Situation, Attaquant, Défenseur) ; erreurs, simulation et résultats à droite (colonne qui reste
    visible au défilement) ; sélecteur de mots-clés dans un panneau latéral. Ouvert depuis l'accueil (route
    AppRoutes.QuickSim), dans la mise en page d'AppShell. Logique commune avec le Full sim : ScenarioEditorPage.
    Si le scénario a changé depuis le calcul, un bandeau avertit que les résultats sont ceux de l'ancien.
*@
@page "/quick-sim"
@inherits ScenarioEditorPage

<MudStack Spacing="3" Class="pa-4">
    <ScenarioToolbar Running="Running" CanSave="CanSave" FileLabel="@FileLabel" OnNew="NewScenarioAsync" OnOpen="OpenAsync" OnSave="SaveAsync" />

    @if (Message is not null)
    {
        <MudAlert Severity="MessageSeverity" ShowCloseIcon="true" CloseIconClicked="ClearMessage" data-test="message">@Message</MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudStack Spacing="3">
                @* Situation en tête (plus visible qu'en bas, choix de l'utilisateur) *@
                <ContextPanel Context="Form.Context" Reference="Reference" Changed="OnFormChanged" />
                <AttackerPanel Attacker="Form.Attacker" Changed="OnAttackerChanged" EditKeywords="EditKeywords"
                               OnOpen="OpenAttackerAsync" OnSave="SaveAttackerAsync" FileActionsDisabled="Running" SaveDisabled="!CanSaveAttacker"
                               SnapShooting="Form.Context.SnapShooting" />
                <DefenderPanel Defender="Form.Defender" Changed="OnDefenderChanged" SnapShooting="Form.Context.SnapShooting"
                               OnOpen="OpenDefenderAsync" OnSave="SaveDefenderAsync" FileActionsDisabled="Running"
                               ShowPrecisionTargets="Reference.PrecisionTargetGroup is not null" PrecisionTarget="@Form.Context.PrecisionTarget"
                               PrecisionTargetChanged="OnPrecisionTargetChanged" />
            </MudStack>
        </MudItem>
        <MudItem xs="12" lg="5">
            <div class="wh-sticky-column">
                <MudStack Spacing="3">
                    <ScenarioErrors Errors="Errors" Warnings="Warnings" HasDiceErrors="HasDiceErrors" />
                    <SimulationPanel @bind-Iterations="Run.Iterations" @bind-Seed="Run.Seed" CanRun="CanRun" Running="Running" Progress="Progress"
                                     OnRun="RunAsync" OnCancel="Cancel" />
                    @if (Run.Result is not null)
                    {
                        @if (ResultIsStale && !Running)
                        {
                            @* Résultats affichés à côté de la saisie : avertissement dans la page plutôt qu'une boîte à chaque modification *@
                            <MudAlert Severity="Severity.Warning" data-test="stale-results-banner">
                                <div>@L["StaleResults_Banner"]</div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                                           StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="!CanRun" OnClick="RunAsync"
                                           data-test="stale-rerun">@L["StaleResults_Rerun"]</MudButton>
                            </MudAlert>
                        }
                        <ResultsView Result="Run.Result" />
                    }
                </MudStack>
            </div>
        </MudItem>
    </MudGrid>
</MudStack>

<KeywordDrawer Weapon="KeywordWeapon" OnClose="CloseKeywords" Changed="OnAttackerChanged" />

@code {
    protected override SimulationRun Run => Session.QuickSim;
}
