@*
    Un profil d'arme et le nombre de figurines qui l'utilisent. Bandeau à gauche, fond plein couleur du camp, avec le
    pictogramme du type (viseur : tir, épées : mêlée). En-tête : nom, type, nombre de porteurs, boutons monter /
    descendre (ordre de résolution) / dupliquer / supprimer ; puis la ligne
    « Profil » (A, CT/CC, F, PA, D de même largeur, comme sur une fiche) et la ligne « Mots-clés », libellés alignés.
    Repliable : une fois replié, une ligne de résumé (Describe du Core). Les mots-clés actifs sont des étiquettes ; le
    bouton « Mots-clés » ouvre le sélecteur (panneau latéral). Ligne « Relances » (pêche aux 6 à la touche, à la
    blessure) seulement quand le Core la juge utile pour cette arme.
*@
@using Wh40kSim.UI.Keywords

<MudPaper Outlined="true" Class="my-3 wh-subcard wh-weapon-card" data-test="weapon">
    @* Bandeau du type d'arme : toute la hauteur de la carte, fond plein couleur du camp, pictogramme centré *@
    <div class="wh-weapon-band">
        <MudTooltip Text="@(Weapon.Type == WeaponType.Melee ? L["Weapon_Melee"] : L["Weapon_Ranged"])">
            <MudIcon Icon="@WeaponIcons.For(Weapon.Type)" Class="wh-weapon-type-icon"
                     data-test="@(Weapon.Type == WeaponType.Melee ? "weapon-melee-icon" : "weapon-ranged-icon")" />
        </MudTooltip>
    </div>
    <div class="wh-weapon-body pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <CollapseToggle @bind-Expanded="_expanded" data-test="toggle-weapon" />
            @if (_expanded)
            {
                @* Identité de l'arme : nom, type et nombre de porteurs *@
                <div class="wh-card-name">
                    <MudTextField T="string" Label="@L["Weapon_Name"]" @bind-Value="Weapon.Name" @bind-Value:after="NotifyChanged" />
                </div>
                <div class="wh-card-type">
                    <MudSelect T="WeaponType" Label="@L["Weapon_Type"]" @bind-Value="Weapon.Type" @bind-Value:after="NotifyChanged">
                        <MudSelectItem T="WeaponType" Value="WeaponType.Ranged">@L["Weapon_Ranged"]</MudSelectItem>
                        <MudSelectItem T="WeaponType" Value="WeaponType.Melee">@L["Weapon_Melee"]</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="wh-card-count">
                    <MudNumericField T="int" Label="@L["Weapon_ModelCount"]" Min="1" @bind-Value="Weapon.ModelCount" @bind-Value:after="NotifyChanged" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="wh-summary" data-test="weapon-summary">@Summary</MudText>
            }
            @* Ordre de résolution des armes : monter = résolue plus tôt, comme les groupes du défenseur *@
            <MudTooltip Text="@L["Weapon_MoveUp"]">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(!CanMoveUp)" OnClick="OnMoveUp" data-test="move-weapon-up" />
            </MudTooltip>
            <MudTooltip Text="@L["Weapon_MoveDown"]">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(!CanMoveDown)" OnClick="OnMoveDown" data-test="move-weapon-down" />
            </MudTooltip>
            <MudTooltip Text="@L["Weapon_Duplicate"]">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="OnDuplicate" data-test="duplicate-weapon" />
            </MudTooltip>
            <MudTooltip Text="@L["Weapon_Remove"]">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="wh-delete" OnClick="OnRemove" data-test="remove-weapon" />
            </MudTooltip>
        </MudStack>

        @if (_expanded)
        {
            @* Ligne de profil, comme sur une fiche : cinq caractéristiques de même largeur *@
            <div class="wh-card-row">
                <MudText Typo="Typo.subtitle2" Class="wh-card-row-label">@L["Weapon_Profile"]</MudText>
                <div class="wh-stat-line" style="--wh-cols: 5" data-test="weapon-profile">
                    <MudTextField T="string" Label="@L["Weapon_Attacks"]" @bind-Value="Weapon.Attacks" @bind-Value:after="NotifyChanged"
                                  Error="@(!IsDice(Weapon.Attacks))" ErrorText="@L["Dice_Invalid"]" data-test="attacks" />
                    <MudSelect T="int" Label="@(Weapon.Type == WeaponType.Ranged ? L["Weapon_BallisticSkill"] : L["Weapon_WeaponSkill"])"
                               Disabled="Weapon.Abilities.Torrent" @bind-Value="Weapon.Skill" @bind-Value:after="NotifyChanged">
                        @foreach (int value in TwoToSix)
                        {
                            <MudSelectItem T="int" Value="value">@($"{value}+")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int" Label="@L["Weapon_Strength"]" Min="1" @bind-Value="Weapon.Strength" @bind-Value:after="NotifyChanged" />
                    <MudNumericField T="int" Label="@L["Weapon_Ap"]" Min="-6" Max="0" @bind-Value="Weapon.Ap" @bind-Value:after="NotifyChanged" />
                    <MudTextField T="string" Label="@L["Weapon_Damage"]" @bind-Value="Weapon.Damage" @bind-Value:after="NotifyChanged"
                                  Error="@(!IsDice(Weapon.Damage))" ErrorText="@L["Dice_Invalid"]" data-test="damage" />
                </div>
            </div>

            <div class="wh-card-row">
                <MudText Typo="Typo.subtitle2" Class="wh-card-row-label">@L["Weapon_Abilities"]</MudText>
                <div class="wh-keywords" data-test="weapon-keywords">
                    @foreach (var keyword in WeaponKeywords.All.Where(k => k.IsActive(Weapon.Abilities)))
                    {
                        <MudTooltip Text="@L[keyword.HelpKey]">
                            <MudChip T="string" Size="Size.Small" Color="@(IsValueInvalid(keyword) ? Color.Error : Color.Primary)" Variant="Variant.Outlined"
                                     OnClick="OnEditKeywords" OnClose="() => Remove(keyword)" data-test="keyword-chip">@ChipLabel(keyword)</MudChip>
                        </MudTooltip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OnEditKeywords" data-test="edit-keywords">@L["Weapon_EditKeywords"]</MudButton>
                </div>
            </div>

            @* Pêche aux 6 : chaque interrupteur n'apparaît que si le Core juge qu'il a un sens pour cette arme *@
            @if (Fishing is var (hits, wounds) && (hits || wounds))
            {
                <div class="wh-card-row" data-test="weapon-fishing">
                    <MudText Typo="Typo.subtitle2" Class="wh-card-row-label">@L["Weapon_Rerolls"]</MudText>
                    <div class="wh-keywords">
                        @if (hits)
                        {
                            <MudSwitch T="bool" Label="@L["Weapon_FishHits"]" Color="Color.Primary" @bind-Value="Weapon.FishForCriticalHits"
                                       @bind-Value:after="NotifyChanged" data-test="fish-hits" />
                        }
                        @if (wounds)
                        {
                            <MudSwitch T="bool" Label="@L["Weapon_FishWounds"]" Color="Color.Primary" @bind-Value="Weapon.FishForCriticalWounds"
                                       @bind-Value:after="NotifyChanged" data-test="fish-wounds" />
                        }
                        <HelpBubble Lines="@([L["Help_Fishing"]])" />
                    </div>
                </div>
            }
        }
    </div>
</MudPaper>

@code {
    private static readonly int[] TwoToSix = [2, 3, 4, 5, 6];

    private bool _expanded = true;

    [Parameter, EditorRequired]
    public WeaponForm Weapon { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback OnDuplicate { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Ouvre le sélecteur de mots-clés pour cette arme.</summary>
    [Parameter]
    public EventCallback OnEditKeywords { get; set; }

    /// <summary>Boosts de l'attaquant : la relance complète ouvre la pêche aux 6.</summary>
    [Parameter]
    public AttackerBoosts Boosts { get; set; } = new();

    /// <summary>Situation : pas de pêche aux 6 à la touche en overwatch.</summary>
    [Parameter]
    public AttackContext Context { get; set; } = new();

    /// <summary>Pêche aux 6 possible à la touche, à la blessure (Core) ; rien tant qu'une expression de dés est invalide.</summary>
    private (bool Hits, bool Wounds) Fishing
    {
        get
        {
            try
            {
                var weapon = Weapon.ToWeaponGroup().Weapon;
                return (weapon.CanFishForCriticalHits(Boosts, Context), weapon.CanFishForCriticalWounds(Boosts));
            }
            catch (FormatException)
            {
                return (false, false);
            }
        }
    }

    /// <summary>Résumé de l'arme par le Core ; seulement le nom tant qu'une expression de dés est invalide.</summary>
    private string Summary
    {
        get
        {
            try
            {
                var group = Weapon.ToWeaponGroup();
                return $"{group.ModelCount} × {group.Weapon.Describe()}";
            }
            catch (FormatException)
            {
                return L["Weapon_SummaryInvalid", Weapon.Name];
            }
        }
    }

    private static bool IsDice(string? text) => DiceExpression.TryParse(text, out _);

    private string ChipLabel(KeywordDefinition<WeaponAbilitiesForm> keyword) =>
        keyword.ValueText(Weapon.Abilities) is string value ? $"{L[keyword.NameKey]} {value}" : L[keyword.NameKey];

    private bool IsValueInvalid(KeywordDefinition<WeaponAbilitiesForm> keyword) =>
        keyword.ValueKind == KeywordValueKind.Dice && !IsDice(keyword.GetText!(Weapon.Abilities));

    private Task Remove(KeywordDefinition<WeaponAbilitiesForm> keyword)
    {
        keyword.SetActive(Weapon.Abilities, false);
        return NotifyChanged();
    }

    private Task NotifyChanged() => Changed.InvokeAsync();
}
