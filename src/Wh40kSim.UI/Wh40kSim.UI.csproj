<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Interface graphique partagée par les hôtes (desktop MAUI, puis web) : composants, services, modèles de formulaire.
    Aucune règle de jeu ni aucun calcul ici : tout passe par Wh40kSim.Core et Wh40kSim.Simulation.
  -->
  <PropertyGroup>
    <RootNamespace>Wh40kSim.UI</RootNamespace>
    <!-- Les textes de Resources/Strings.resx sont en français : pas de ressources satellites à chercher pour fr / fr-FR -->
    <NeutralLanguage>fr</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wh40kSim.Core\Wh40kSim.Core.csproj" />
    <ProjectReference Include="..\Wh40kSim.Simulation\Wh40kSim.Simulation.csproj" />
  </ItemGroup>

</Project>
